{
  "name": "kb",
  "private": true,
  "description": "Personal LLM wiki — formatting and TypeScript tooling",
  "scripts": {
    "format:check": "prettier --check \"wiki/**/*.md\"",
    "format:write": "prettier --write \"wiki/**/*.md\"",
    "kb:slug": "tsx scripts/kb/slug.ts",
    "kb:lint": "tsx scripts/kb/wiki-lint.ts",
    "kb:import-firefox": "tsx scripts/kb/import-firefox.ts",
    "kb:import-firefox-tabs": "tsx scripts/kb/import-firefox-tabs.ts",
    "kb:generate-tab-classify-plan": "tsx scripts/kb/generate-tab-classify-plan.ts",
    "kb:reclassify": "tsx scripts/kb/apply-llm-reclassify.ts",
    "kb:reclassify:legacy": "tsx scripts/kb/apply-reclassify.ts",
    "test": "tsx --test scripts/kb/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "prettier": "3.9.6",
    "prettier-plugin-compact-markdown-table": "0.1.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
